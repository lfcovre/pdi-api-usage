{
  "info": {
    "_postman_id": "91d3eff4-5bec-4968-944b-2b23d671eea5",
    "name": "PDI API Usage",
    "description": "Collection do projeto PDI API Usage. Reúne os quatro cenários principais e a variação Carte com repository informado na requisição. Use junto com postman/environments/local.example.postman_environment.json.\n\nOs endpoints fazem parte da API Carte e podem ser expostos tanto pelo Carte Standalone quanto pelo Carte incorporado ao Pentaho Server. A escolha entre execute* e run* depende principalmente de como o artefato será localizado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"HTTP status is 200\", function () {",
          "    pm.response.to.have.status(200);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "log_level",
      "value": "Basic",
      "type": "string"
    },
    {
      "key": "p_message",
      "value": "Mensagem enviada pela API REST do PDI",
      "type": "string"
    },
    {
      "key": "repository_trans_path",
      "value": "/public/pdi-api-usage/trf_api_test",
      "type": "string"
    },
    {
      "key": "repository_job_path",
      "value": "/public/pdi-api-usage/job_api_test",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Pentaho Server - Filesystem",
      "description": "Engine PDI incorporada ao Pentaho Server. Artefatos carregados do filesystem com executeTrans/executeJob.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{pentaho_server_user}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{pentaho_server_password}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Transformation - executeTrans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pentaho_server_url}}/kettle/executeTrans",
              "host": [
                "{{pentaho_server_url}}"
              ],
              "path": [
                "kettle",
                "executeTrans"
              ],
              "query": [
                {
                  "key": "trans",
                  "value": "{{trans_file_path}}"
                },
                {
                  "key": "level",
                  "value": "{{log_level}}"
                },
                {
                  "key": "P_MESSAGE",
                  "value": "{{p_message}}"
                }
              ]
            },
            "description": "Executa trf_api_test.ktr pelo Pentaho Server. Sem rep, trans é tratado como caminho físico. Em sucesso, executeTrans pode retornar corpo vazio; confirme também no pdi.log."
          },
          "response": []
        },
        {
          "name": "Job - executeJob",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pentaho_server_url}}/kettle/executeJob",
              "host": [
                "{{pentaho_server_url}}"
              ],
              "path": [
                "kettle",
                "executeJob"
              ],
              "query": [
                {
                  "key": "job",
                  "value": "{{job_file_path}}"
                },
                {
                  "key": "level",
                  "value": "{{log_level}}"
                },
                {
                  "key": "P_MESSAGE",
                  "value": "{{p_message}}"
                }
              ]
            },
            "description": "Executa job_api_test.kjb pelo Pentaho Server. Sem rep, job é tratado como caminho físico."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text();",
                  "pm.test(\"PDI returned OK\", function () {",
                  "    pm.expect(body).to.include(\"<result>OK</result>\");",
                  "});",
                  "pm.test(\"Job was started\", function () {",
                  "    pm.expect(body).to.include(\"<message>Job started</message>\");",
                  "});",
                  "pm.test(\"Execution ID was returned\", function () {",
                  "    pm.expect(body).to.match(/<id>[^<]+<\\/id>/);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
