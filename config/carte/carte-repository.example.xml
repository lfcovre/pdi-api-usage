<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracao do Carte Standalone com Pentaho Repository pre-configurado.

  Usada pelo Ex04. Copie este arquivo para carte-repository.xml e substitua
  os valores do repository. O arquivo local carte-repository.xml e ignorado
  pelo Git.

  O nome do repository deve corresponder a uma definicao disponivel no
  repositories.xml visivel ao usuario do sistema operacional que inicia Carte.
-->
<slave_config>
  <slaveserver>
    <name>carte-local</name>
    <hostname>localhost</hostname>
    <port>9090</port>
    <username>cluster</username>
    <password>cluster</password>
    <master>N</master>
  </slaveserver>

  <repository>
    <name>REPOSITORY_NAME</name>
    <username>REPOSITORY_USER</username>
    <password>REPOSITORY_PASSWORD</password>
  </repository>
</slave_config>
