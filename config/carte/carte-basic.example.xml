<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracao basica do Carte Standalone.

  Usada pelo Ex03 (filesystem) e pela variacao de repository explicito.
  O arquivo pode permanecer dentro deste projeto. Carte.bat aceita seu caminho
  completo como argumento.
-->
<slave_config>
  <slaveserver>
    <name>carte-local</name>
    <hostname>localhost</hostname>
    <port>9090</port>
    <username>cluster</username>
    <password>cluster</password>
    <master>N</master>
  </slaveserver>
</slave_config>
